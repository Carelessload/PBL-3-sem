// basic version: just lists the doctors of that specialty (ranking comes later)
void showDoctors(const vector<Doctor>& doctors, const string& specialty) {
    bool found = false;
    for (auto& d : doctors)
        if (d.getSpecialty() == specialty) {
            cout << "    - " << d.getName() << " | " << d.getExperience() << " yrs | rating "
                 << d.getRating() << " | " << d.getHospital() << "\n";
            found = true;
        }
    if (!found) cout << "    No doctor found for this specialty.\n";
}

