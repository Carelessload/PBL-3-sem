class SpecialistMap {
private:
    unordered_map<string, string> table;   // condition name -> specialist
public:
    void build(const vector<Condition>& conditions) {
        for (auto& c : conditions) table[c.getName()] = c.getSpecialist();
    }
    string get(const string& condition) const {
        auto it = table.find(condition);
        if (it == table.end()) throw NoMatchException();
        return it->second;
    }
};

